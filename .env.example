# RAG_Wright environment template. Copy to .env and fill in. Never commit .env.
# Secrets live only in .env (SPEC.md §14 boundaries).

# --- Model serving (default path: OpenRouter; local open-model deployment supported) ---
OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- ArcadeDB (single store: hybrid retrieval index + knowledge graph) ---
# ARCADEDB_HOST=localhost
# ARCADEDB_PORT=2480
# ARCADEDB_USER=
# ARCADEDB_PASSWORD=
# ARCADEDB_DATABASE=rag_wright

# --- Object store (MinIO or equivalent), if used ---
# OBJECT_STORE_ENDPOINT=
# OBJECT_STORE_ACCESS_KEY=
# OBJECT_STORE_SECRET_KEY=
